# MPLADS AI Monitor Environment Configuration

# Database Configuration (PostgreSQL / PostGIS or SQLite fallback)
# PostgreSQL format: postgresql://postgres:postgres@localhost:5432/mplads_db
# Default local SQLite fallback for seamless execution: sqlite:///./mplads.db
DATABASE_URL=sqlite:///./mplads.db

# API Settings
API_TITLE="MPLADS AI Monitor REST API"
API_VERSION="1.0.0"
ENV="development"

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
SECRET_KEY="mplads-ai-monitor-super-secret-key-change-in-production"

# ISRO Bhuvan Geospatial Service Configuration (Configuration-Ready for Future Activation)
BHUVAN_WMS_URL=
BHUVAN_WMTS_URL=
BHUVAN_GEOCODING_URL=
BHUVAN_ACCESS_TOKEN=

